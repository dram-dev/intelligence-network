<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dr.intelnet.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>intelnet</string>
        <string>pipeline</string>
        <string>--run-type</string>
        <string>daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_PATH__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/dramsey/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/usr/sbin:/sbin:/bin</string>
    </dict>

    <!-- Third in the overnight queue: macro 01:00 → PC 01:05 → this at 01:10.
         The pipeline blocks on the shared cross-digest lock
         (/tmp/digest-pipeline.lock) until the others finish, so the three never
         share Ollama/MLX at once. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>1</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__PROJECT_PATH__/logs/daily.out.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_PATH__/logs/daily.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
