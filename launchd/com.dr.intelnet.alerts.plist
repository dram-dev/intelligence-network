<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dr.intelnet.alerts</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>intelnet</string>
        <string>alert-loop</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_PATH__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/dramsey/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/usr/sbin:/sbin:/bin</string>
        <key>HOME</key>
        <string>/Users/dramsey</string>
    </dict>

    <!-- The alert lane: NWS alerts every ~30 s plus retries of undelivered
         pushes. Always restarted; while it is down the 5-minute watch polls
         alerts instead. -->
    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_PATH__/logs/alerts.out.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_PATH__/logs/alerts.err.log</string>
</dict>
</plist>
