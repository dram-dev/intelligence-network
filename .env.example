# ── Intelligence Network — copy to .env and fill in ──────────────────────────

# SQLite state (sensors, signals, events, subscriptions). Local file; the
# digest itself is published to Google Drive, not to disk.
DB_PATH=./data/network.db
LOG_LEVEL=INFO

# ── Telegram (the primary push + pull channel) ─────────────────────────────
# Create a NEW bot via @BotFather (do not reuse the PC/macro digest bots — each
# bot has one getUpdates consumer). Your own chat id (from @userinfobot) is the
# admin: it can /admin ban|trust|broadcast. Anyone else who /join's is a sensor.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# The bot's @handle (without @) — linked from the site, the digest and /privacy.
TELEGRAM_BOT_HANDLE=
# Optional community group link shown on the site.
TELEGRAM_GROUP_URL=
NOTIFY_ENABLED=true
# Quiet hours apply ONLY to the daily digest ping (local time). Warnings and
# corroborated events are opt-in subscriptions and are never suppressed.
NOTIFY_QUIET_START_HOUR=22
NOTIFY_QUIET_END_HOUR=8

# ── Network policy ────────────────────────────────────────────────────────
NETWORK_NAME=Intelligence Network
# Public contact (site footer, privacy policy, /privacy).
NETWORK_CONTACT_EMAIL=

# ── Public site (GitHub Pages from docs/) ─────────────────────────────────
GITHUB_REPO=dram-dev/intelligence-network
# Defaults to https://<owner>.github.io/<repo>/ from GITHUB_REPO.
SITE_URL=
# After each daily run, commit + push docs/ so Pages redeploys with fresh data.
SITE_AUTO_PUSH=false
# Empty = anyone can /join. Set a word and /join <word> is required.
NETWORK_JOIN_CODE=
# Contributions per sensor per 10 minutes (abuse guard).
NETWORK_RATE_LIMIT=20
# Corroborated-event push gate (see network.score_event).
EVENT_PUSH_MIN_SCORE=1.0

# ── Geography: Illinois, counties + ZIP / ZIP+4 ───────────────────────────
GEO_STATE=IL
# Ask api.weather.gov which county a shared lat/lon falls in (cached). Off →
# nearest county centroid from the vendored table (fine away from borders).
GEO_ONLINE_LOOKUP=true
# NWS requires a User-Agent that identifies you (any contact string).
NWS_USER_AGENT=intelligence-network (you@example.com)

# ── Reference feeds (pull side) ───────────────────────────────────────────
# Station observations are polled at most this often (each poll = ~56 IL ASOS
# stations × ~7 metrics of reference signals). Alerts + storm reports every run.
STATION_POLL_MINUTES=60
LSR_LOOKBACK_HOURS=3
# Reference-sensor signals (stations/alerts/LSR) are pruned after this many
# days; human contributions are kept forever.
REFERENCE_RETENTION_DAYS=30
NEWS_ENABLED=true

# ── Local LLMs (shared with the PC + macro digests on this Mac mini) ─────
# Free-text contributions ("golf-ball hail here 5 min ago") are parsed into
# signals by Ollama; the daily digest narrative + news triage use the MLX
# server. Everything works without them (grammar parser, no narrative).
LLM_ENABLED=true
PARSER_BACKEND=local_qwen
TRIAGE_BACKEND=local_qwen
SUMMARIZER_BACKEND=mlx_local
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.6:35b-a3b
OLLAMA_THINK=false
MLX_SERVER_URL=http://localhost:8080
MLX_MODEL=mlx-community/Qwen3.6-27B-4bit
SUMMARIZER_TIMEOUT_SEC=120

# ── Google Drive (where the digest lives + is subscribed to) ─────────────
# OAuth Desktop client JSON from Google Cloud Console → secrets/ (see
# secrets/README.md). Scope is drive.file: the app only ever sees the folder
# and docs it creates itself. `intelnet drive init` creates the folder and the
# fixed-link "Latest" doc and stores their ids in the DB.
GDRIVE_ENABLED=true
GDRIVE_CREDENTIALS_PATH=./secrets/gdrive_credentials.json
GDRIVE_TOKEN_PATH=./secrets/gdrive_token.json
GDRIVE_FOLDER_NAME=Intelligence Network
# The Google account that owns the public digest folder (sign-in pre-selects it,
# and publishing refuses any other account).
GDRIVE_ACCOUNT=
# "Anyone with the link can view" on the folder, so /latest works for everyone.
# Off → only emails added via /subscribe digest <email> can open it.
GDRIVE_PUBLIC_LINK=true
